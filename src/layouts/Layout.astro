---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Instalaciones Eléctricas · CABA y GBA · Stuttgart Tableros para Obras",
  description = "Stuttgart — instalaciones eléctricas en CABA y GBA. Tableros de distribución y maniobra, obras comerciales e industriales, mediciones, certificaciones DCI, mantenimiento preventivo y seguridad electrónica. Técnico matriculado.",
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="theme-color" content="#111111" />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="instalaciones eléctricas CABA, instalaciones eléctricas GBA, tableros eléctricos Buenos Aires, tableros para obras, obras eléctricas comerciales, obras eléctricas industriales, mediciones eléctricas, certificación DCI Buenos Aires, Resolución 900/15, puesta a tierra, calidad de energía, mantenimiento eléctrico preventivo, seguridad electrónica, cámaras de seguridad, electricista matriculado Buenos Aires, Stuttgart ingeniería eléctrica"
    />
    <meta name="author" content="Stuttgart Soluciones Eléctricas" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Stuttgart Soluciones Eléctricas" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48x48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- JSON-LD: LocalBusiness -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Stuttgart Soluciones Eléctricas",
      "alternateName": "Stuttgart Ingeniería",
      "slogan": "Tableros, obras e instalaciones eléctricas en CABA y GBA",
      "description": "Empresa de instalaciones eléctricas en CABA y GBA. Tableros de distribución y maniobra para obras comerciales e industriales, mediciones eléctricas, certificaciones DCI, Res. 900/15, mantenimiento preventivo y seguridad electrónica. Técnico matriculado.",
      "url": "https://stuttingenieria.com",
      "telephone": "+54-911-2392-1232",
      "email": "presupuestos@stuttingenieria.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Buenos Aires",
        "addressRegion": "Buenos Aires",
        "addressCountry": "AR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -34.6037,
        "longitude": -58.3816
      },
      "areaServed": [
        { "@type": "City", "name": "Ciudad Autónoma de Buenos Aires" },
        { "@type": "AdministrativeArea", "name": "Gran Buenos Aires" }
      ],
      "knowsAbout": [
        "instalaciones eléctricas",
        "tableros eléctricos",
        "obras eléctricas",
        "mediciones eléctricas",
        "puesta a tierra",
        "certificación DCI",
        "Resolución 900/15",
        "mantenimiento eléctrico preventivo",
        "seguridad electrónica"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Servicios eléctricos",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Obras eléctricas comerciales e industriales" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Tableros eléctricos de distribución y maniobra" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Mediciones eléctricas y puesta a tierra" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Certificación DCI y Resolución 900/15" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Mantenimiento eléctrico preventivo y correctivo" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Seguridad electrónica y cámaras de vigilancia" } }
        ]
      },
      "sameAs": [
        "https://www.instagram.com/stuttingenieria/"
      ]
    }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
